rules_version = '2';

// Uygulama Firestore'u istemciden kullanmaz. Tek koleksiyon (aiUsage) yalnızca
// bulut fonksiyonları tarafından Admin SDK ile yazılır; istemciye tamamen kapalı.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
