<?xml version="1.0" encoding="utf-8"?>
<!-- Finans verisi ve şifreleme anahtarı bulut yedeğine ya da cihazdan cihaza
     aktarıma dahil edilmez. Anahtar Keystore'da kaldığı için yedeklenen kutu
     zaten açılamaz; geri yüklemede bozuk veri oluşmasını da böylece önleriz. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
